satisfying \!\(\*SubscriptBox[\(D\), \
\(g\)]\)\[CenterDot]\!\(\*SubscriptBox[OverscriptBox[\(b\), \
\(\[RightArrow]\)], \(g\)]\) = \!\(\*SubscriptBox[OverscriptBox[\(b\), \(\
\[RightArrow]\)], \(g\)] mod \!\(\*SubscriptBox[\(\[CapitalLambda]\), \(\
\[Perpendicular]\)]\)\), i.e. leaving the space group fixed-point-free given \
the point group generator \!\(\*SubscriptBox[\(D\), \(g\)]\).", 
    "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[
     DownValues, CasimirRFM`GetAllowedShifts, {CasimirRFM`GetAllowedShifts[
         Pattern[CasimirRFM`Private`Dg, 
          Blank[]]] :> 
       Block[{CasimirRFM`Private`bg = Array[CasimirRFM`Private`b, 
            Length[CasimirRFM`Private`Dg]], CasimirRFM`Private`b, 
          CasimirRFM`Private`vars, CasimirRFM`Private`order = 
          CasimirRFM`ElementOrder[{CasimirRFM`Private`Dg, 
             ConstantArray[0, 
              Length[CasimirRFM`Private`Dg]], 0}], 
          CasimirRFM`Private`p = $CellContext`p, CasimirRFM`Private`subspace},
          CasimirRFM`Private`subspace = (Dot[
            Array[CasimirRFM`Private`p, 
             Length[#]], #]& )[
            (Map[Part[#, 2]& , 
             (Cases[#, {0, 
               Blank[]}]& )[
              Transpose[
               Eigensystem[IdentityMatrix[
                  Length[#]] - #]]]]& )[CasimirRFM`Private`Dg]]; 
         CasimirRFM`Private`bg = MapIndexed[If[# === 0, 
             CasimirRFM`Private`b[
              Part[#2, 1]], #]& , CasimirRFM`Private`subspace]; 
         CasimirRFM`Private`vars = Cases[CasimirRFM`Private`bg, 
            CasimirRFM`Private`b[
             Blank[]]]; ReplaceAll[
           ReplaceAll[CasimirRFM`Private`bg/CasimirRFM`Private`order, 
            Solve[Dot[IdentityMatrix[
                 Length[CasimirRFM`Private`Dg]] - CasimirRFM`Private`Dg, 
