                    RowBox[{
                    RowBox[{"Ewald", "[", 
                    RowBox[{
                    RowBox[{"CasimirRFM`Private`c0_", "?", "VectorQ"}], ",", 
                    RowBox[{"CasimirRFM`Private`h0_", "?", "VectorQ"}], ",", 
