\[RightArrow]\\)]\\) = {\\!\\(\\*SubscriptBox[\\(h\\), \\(1\\)]\\),...,\\!\\(\
\\*SubscriptBox[\\(h\\), \\(k\\)]\\)}; \\!\\(\\*StyleBox[\\\"\[Epsilon]\\\", \
\\\"TI\\\"]\\) controls the estimated truncation of the numerical sums such \
that \\!\\(\\*StyleBox[\\\"\[Epsilon]\\\", \\\"TI\\\"] = \
\\*SuperscriptBox[10,\\(-p\\)]\\) targets roughly \
\\!\\(\\*StyleBox[\\\"p\\\", \\\"TI\\\"]\\) decimal digits \
(\\!\\(\\*StyleBox[\\\"\[Epsilon]\\\", \\\"TI\\\"] = \
\\*SuperscriptBox[10,\\(-4\\)]\\) by default).\"\>", "InformationUsageText",
             StripOnInput->False,
