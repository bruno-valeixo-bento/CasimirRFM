   "ObjectType" -> "Symbol", "Usage" -> 
    "ElementOrder[g] returns the order k of the element g such that \
\!\(\*SuperscriptBox[\(g\), \(k\)]\) = \[DoubleStruckOne]. It takes g as an \
affine torus isometry, not taking into account the spin lift (which might \
therefore be omitted).", "Documentation" -> None, "OwnValues" -> None, 
    "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, CasimirRFM`ElementOrder, {CasimirRFM`ElementOrder[
         Pattern[CasimirRFM`Private`g, 
          Blank[List]]] :> 
       Module[{CasimirRFM`Private`id, CasimirRFM`Private`el, 
          CasimirRFM`Private`res, CasimirRFM`Private`k, 
          CasimirRFM`Private`count = 1, CasimirRFM`Private`maxCount = 10^4}, 
         If[
           MatchQ[CasimirRFM`Private`g, {
             PatternTest[
              Blank[], MatrixQ], 
             PatternTest[
              Blank[], VectorQ], 
             PatternTest[
              Blank[], NumericQ]}], 
           CasimirRFM`Private`el = CasimirRFM`Private`g; Null, If[
             MatchQ[CasimirRFM`Private`g, {
               PatternTest[
                Blank[], MatrixQ], 
               PatternTest[
                Blank[], VectorQ]}], CasimirRFM`Private`el = 
             Append[CasimirRFM`Private`g, 0], Message[
               MessageName[CasimirRFM`ElementOrder, "arg"]]; Return[$Failed]]; 
           Null]; CasimirRFM`Private`k = Length[
            First[CasimirRFM`Private`g]]; CasimirRFM`Private`id = {
            IdentityMatrix[CasimirRFM`Private`k], 
            ConstantArray[0, CasimirRFM`Private`k]}; 
         CasimirRFM`Private`res = CasimirRFM`Private`el; While[
           Not[Part[CasimirRFM`Private`res, 
              Span[1, 2]] === CasimirRFM`Private`id], 
           If[CasimirRFM`Private`count > CasimirRFM`Private`maxCount, 
             Message[
               MessageName[CasimirRFM`ElementOrder, "iter"], 
               CasimirRFM`Private`maxCount]; Return[$Failed]]; 
           CasimirRFM`Private`res = 
            CasimirRFM`ComposeElements[
             CasimirRFM`Private`el, CasimirRFM`Private`res]; 
           Increment[CasimirRFM`Private`count]]; 
         Return[CasimirRFM`Private`count]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {}, "FullName" -> 
    "CasimirRFM`ElementOrder"|>, False]]], "Output",
