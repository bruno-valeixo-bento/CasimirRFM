                    RowBox[{"CasimirRFM`Private`GetEwaldLatticeByNorm", "[", 
                    
                    RowBox[{"CasimirRFM`Private`rmaxn", ",", 
                    "CasimirRFM`Private`G", ",", "CasimirRFM`Private`c"}], 
                    "]"}], "]"}]}], ";", 
                    RowBox[{"CasimirRFM`Private`pointsk", "=", 
