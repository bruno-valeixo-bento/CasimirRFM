      ImageSize->Automatic],
     DynamicModuleValues:>{}],
    BaseStyle->"InformationGridFrame",
    StripOnInput->False], "InformationGridPlain",
   StripOnInput->False],
  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "TraceSpinor[g,\[DoubleStruckCapitalD],Weyl] computes the trace of \
element g in the spinor representation of SO(\[DoubleStruckCapitalD]-2), \
given the choice of spin lift of g. Set \!\(\*StyleBox[\"Weyl\",\n\
FontWeight->\"Bold\"]\)\!\(\*StyleBox[\" \",\n\
FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"=\",\n\
FontWeight->\"Bold\"]\)\!\(\*StyleBox[\" \",\n\
FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"True\",\nFontWeight->\"Bold\"]\) for \
a Weyl spinor (\!\(\*StyleBox[\"Weyl\",\n\
FontWeight->\"Bold\"]\)\!\(\*StyleBox[\" \",\n\
FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"=\",\n\
FontWeight->\"Bold\"]\)\!\(\*StyleBox[\" \",\n\
FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"False\",\nFontWeight->\"Bold\"]\) by \
default; note that Weyl spinors only exist in even dimension).", 
    "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[
     DownValues, CasimirRFM`TraceSpinor, {CasimirRFM`TraceSpinor[
         Pattern[CasimirRFM`Private`g, 
          Blank[]], 
         PatternTest[
          Pattern[CasimirRFM`Private`Dim, 
           Blank[]], IntegerQ], 
         Optional[
          Pattern[CasimirRFM`Private`Weyl, 
           PatternTest[
            Blank[], BooleanQ[#]& ]], False]] :> 
       Module[{CasimirRFM`Private`angles, CasimirRFM`Private`k, 
          CasimirRFM`Private`Sp, CasimirRFM`Private`Sm, CasimirRFM`Private`S},
          If[
           EvenQ[CasimirRFM`Private`Dim], 
           CasimirRFM`Private`k = (CasimirRFM`Private`Dim - 2)/2; 
           CasimirRFM`Private`angles = (Join[#, 
              ConstantArray[0, CasimirRFM`Private`k - Length[#]]]& )[
              Select[
               Arg[
                Eigenvalues[
                 Part[CasimirRFM`Private`g, 1]]], # > 0& ]]; 
           CasimirRFM`Private`Sp = Select[
              Tuples[{1/2, -(1/2)}, CasimirRFM`Private`k], Product[
                Part[#, CasimirRFM`Private`i], {
                CasimirRFM`Private`i, CasimirRFM`Private`k}] > 0& ]; 
           CasimirRFM`Private`Sm = Select[
              Tuples[{1/2, -(1/2)}, CasimirRFM`Private`k], Product[
                Part[#, CasimirRFM`Private`i], {
                CasimirRFM`Private`i, CasimirRFM`Private`k}] < 0& ]; 
           Return[Exp[2 Pi I Part[CasimirRFM`Private`g, 3]] FullSimplify[Total[
                 Map[
                 Exp[I Dot[CasimirRFM`Private`angles, #]]& , 
                  CasimirRFM`Private`Sp]] + 
               If[CasimirRFM`Private`Weyl, 0, 1] Total[
                  Map[
                  Exp[I Dot[CasimirRFM`Private`angles, #]]& , 
                   CasimirRFM`Private`Sm]]]], 
           CasimirRFM`Private`k = (CasimirRFM`Private`Dim - 3)/2; 
           CasimirRFM`Private`angles = (Join[#, 
              ConstantArray[0, CasimirRFM`Private`k - Length[#]]]& )[
              Select[
               Arg[
                Eigenvalues[
                 Part[CasimirRFM`Private`g, 1]]], # > 0& ]]; 
           CasimirRFM`Private`S = Tuples[{1/2, -(1/2)}, CasimirRFM`Private`k]; 
           Return[Exp[2 Pi I Part[CasimirRFM`Private`g, 3]] FullSimplify[
               Total[
                Map[
                Exp[I Dot[CasimirRFM`Private`angles, #]]& , 
                 CasimirRFM`Private`S]]]]]; Null]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {}, "FullName" -> 
    "CasimirRFM`TraceSpinor"|>, False]]], "Output",
