\(2\)]\),...}] returns the finite group generated by \
{\!\(\*SubscriptBox[\(g\), \(1\)]\),\!\(\*SubscriptBox[\(g\), \(2\)]\),...}.",
     "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[
     DownValues, CasimirRFM`GetGroup, {CasimirRFM`GetGroup[
         Pattern[CasimirRFM`Private`gens, 
          Blank[List]]] :> 
       Module[{CasimirRFM`Private`G, CasimirRFM`Private`new, 
          CasimirRFM`Private`group, CasimirRFM`Private`maxIterations = 10^3}, 
         If[
           Not[
            AllTrue[CasimirRFM`Private`gens, MatchQ[#, {
               PatternTest[
                Blank[], MatrixQ], 
               PatternTest[
                Blank[], VectorQ], 
               PatternTest[
                Blank[], NumericQ]}]& ]], Message[
             MessageName[CasimirRFM`GetGroup, "arg"]]; Return[$Failed]]; 
         CasimirRFM`Private`G = DeleteDuplicates[
            Map[{
              Part[#, 1], 
              Mod[
               Part[#, 2], 1], 
              Part[#, 3]}& , CasimirRFM`Private`gens], SameQ]; 
         CasimirRFM`Private`group = FixedPointList[
            Function[
            CasimirRFM`Private`h, CasimirRFM`Private`new = DeleteDuplicates[
                Flatten[
                 Outer[
                 CasimirRFM`ComposeElements, CasimirRFM`Private`gens, 
                  CasimirRFM`Private`h, 1], 1], SameQ]; DeleteDuplicates[
               Join[CasimirRFM`Private`h, CasimirRFM`Private`new], SameQ]], 
            CasimirRFM`Private`G, CasimirRFM`Private`maxIterations]; If[
           Not[
           Part[CasimirRFM`Private`group, -1] === 
            Part[CasimirRFM`Private`group, -2]], Message[
             MessageName[CasimirRFM`GetGroup, "iter"], 
             CasimirRFM`Private`maxIterations]; Return[$Failed]]; 
         Last[CasimirRFM`Private`group]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {}, "FullName" -> 
    "CasimirRFM`GetGroup"|>, False]]], "Output",
