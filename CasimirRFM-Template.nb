                    ")"}]}, "Inverse", SyntaxForm -> SuperscriptBox], ".", 
                    RowBox[{"Transpose", "[", "#1", "]"}]}], "&"}], ")"}], 
                    "[", "CasimirRFM`Private`M", "]"}], ".", 
                    
                    RowBox[{"CasimirRFM`Private`el", "\[LeftDoubleBracket]", 
                    "2", "\[RightDoubleBracket]"}]}]}], ";", 
                    RowBox[{"CasimirRFM`Private`vg", "=", 
                    RowBox[{
                    RowBox[{"Transpose", "[", "CasimirRFM`Private`V", "]"}], 
                    ".", "CasimirRFM`Private`bgp"}]}], ";", 
                    RowBox[{
                    RowBox[{"(", 
