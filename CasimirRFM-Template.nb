Cell[BoxData[{
 RowBox[{"?", "GetInvariantMetric"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "/@", 
  RowBox[{"GetInvariantMetric", "[", "gens", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"G", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"GetInvariantMetric", "[", "gens", "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}], "/.", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SubscriptBox["c", "1"], "->", 
        RowBox[{
         SuperscriptBox["R", "2"], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "6"}], "u"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        SubscriptBox["c", "2"], "->", 
        RowBox[{
         SuperscriptBox["R", "2"], 
         RowBox[{"Exp", "[", "u", "]"}], " ", 
         RowBox[{"Exp", "[", "w", "]"}], 
         RowBox[{"Cosh", "[", "\[Zeta]", "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        SubscriptBox["c", "3"], "->", 
        RowBox[{
         SuperscriptBox["R", "2"], 
         RowBox[{"Exp", "[", "u", "]"}], 
         RowBox[{"Exp", "[", "w", "]"}], 
         FractionBox[
          RowBox[{"Sinh", "[", "\[Zeta]", "]"}], 
          SqrtBox["2"]]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        SubscriptBox["c", "4"], "->", 
        RowBox[{
         SuperscriptBox["R", "2"], 
         RowBox[{"Exp", "[", "u", "]"}], 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "2"}], "w"}], "]"}]}]}]}], "}"}]}]}], ")"}], "//", 
  "MatrixForm"}]}], "Input",
