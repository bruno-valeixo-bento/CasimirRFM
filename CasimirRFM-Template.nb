                    RowBox[{"0", ",", "CasimirRFM`Private`k"}], "]"}]}], 
                    "]"}], "&"}]}], "]"}]}], "]"}]}], ";", 
                    RowBox[{"CasimirRFM`Private`sum", "+=", 
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    UnderoverscriptBox["\[Sum]", "CasimirRFM`Private`i", 
