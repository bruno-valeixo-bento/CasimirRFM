       Module[{CasimirRFM`Private`k = Length[CasimirRFM`Private`point], 
          CasimirRFM`Private`dx}, 
         DistributeDefinitions[
          CasimirRFM`Private`eps, CasimirRFM`Private`k]; (1/
           CasimirRFM`Private`V[CasimirRFM`Private`point]) 
          ParallelTable[
           If[Part[CasimirRFM`Private`point, CasimirRFM`Private`i] == 0, 
