   StripOnInput->False],
  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "ReducedLatticeSum[\[DoubleStruckCapitalD],g,h,G,\[Epsilon]] computes the \
lattice sum numerically, projecting onto the g-invariant lattice, i.e. \
collapsing the sum to the lowest dimension possible, before numerically \
summing using the Ewald summation method. The lattice sum corresponds (up to \
a numerical factor) to the contribution to the D-dimensional Casimir \
potential of element g on a background with metric G and fermion boundary \
conditions \!\(\*OverscriptBox[\(h\), \(\[RightArrow]\)]\) = \
{\!\(\*SubscriptBox[\(h\), \(1\)]\),...,\!\(\*SubscriptBox[\(h\), \(k\)]\)}; \
\!\(\*StyleBox[\"\[Epsilon]\", \"TI\"]\) controls the estimated truncation of \
the numerical sums such that \!\(\*StyleBox[\"\[Epsilon]\", \"TI\"] = \
\*SuperscriptBox[10,\(-p\)]\) targets roughly \!\(\*StyleBox[\"p\", \"TI\"]\) \
decimal digits (\!\(\*StyleBox[\"\[Epsilon]\", \"TI\"] = \*SuperscriptBox[10,\
\(-4\)]\) by default).", "Documentation" -> None, "OwnValues" -> None, 
    "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, CasimirRFM`ReducedLatticeSum, {CasimirRFM`ReducedLatticeSum[
         PatternTest[
          Pattern[CasimirRFM`Private`Dim, 
           Blank[]], IntegerQ], 
         Pattern[CasimirRFM`Private`el, 
          Blank[]], 
         PatternTest[
          Pattern[CasimirRFM`Private`hvec, 
           Blank[]], VectorQ], 
         PatternTest[
          Pattern[CasimirRFM`Private`G, 
           Blank[]], MatrixQ], 
         Optional[
          Pattern[CasimirRFM`Private`\[Epsilon], 
           Blank[]], 
          Rational[1, 10000]]] :> 
       Block[{CasimirRFM`Private`s = CasimirRFM`Private`Dim/2, 
          CasimirRFM`Private`k = Length[CasimirRFM`Private`G], 
          CasimirRFM`Private`Dg = Part[CasimirRFM`Private`el, 1], 
          CasimirRFM`Private`sp, CasimirRFM`Private`kp, CasimirRFM`Private`Gp,
           CasimirRFM`Private`V, CasimirRFM`Private`M, 
          CasimirRFM`Private`Vinv, CasimirRFM`Private`bgp, 
          CasimirRFM`Private`vg, CasimirRFM`Private`\[Eta]vec = Table[
            CasimirRFM`Private`\[Eta][CasimirRFM`Private`i], {
            CasimirRFM`Private`i, 
             Length[CasimirRFM`Private`hvec]}], CasimirRFM`Private`\[Beta]vec,
           CasimirRFM`Private`dvec, CasimirRFM`Private`sum, 
          CasimirRFM`Private`\[Alpha], CasimirRFM`Private`precision = 
          N[CasimirRFM`Private`\[Epsilon]]}, If[
           Or[
            Not[
             AllTrue[CasimirRFM`Private`G, NumericQ, 2]], 
            Not[
             PositiveDefiniteMatrixQ[CasimirRFM`Private`G]]], Message[
             MessageName[CasimirRFM`ReducedLatticeSum, "metric"]]; 
           Return[$Failed]; Null]; 
         CasimirRFM`Private`\[Alpha] = 
          N[Pi Det[CasimirRFM`Private`G]^((-1)/CasimirRFM`Private`k)]; {
           CasimirRFM`Private`V, CasimirRFM`Private`kp} = ({
            Transpose[#], 
            Length[#]}& )[
            NullSpace[
             Transpose[
             IdentityMatrix[CasimirRFM`Private`k] - CasimirRFM`Private`Dg]]]; 
         CasimirRFM`Private`M = 
          If[IdentityMatrix[CasimirRFM`Private`k] == CasimirRFM`Private`Dg, 
            IdentityMatrix[CasimirRFM`Private`k], 
            Transpose[
             NullSpace[
             IdentityMatrix[CasimirRFM`Private`k] - CasimirRFM`Private`Dg]]]; 
         If[CasimirRFM`Private`M == {}, 
           Return[0.]]; 
         CasimirRFM`Private`Vinv = Transpose[CasimirRFM`Private`M]; 
         CasimirRFM`Private`sp = 
          CasimirRFM`Private`s + (CasimirRFM`Private`kp - 
             CasimirRFM`Private`k)/2; 
         CasimirRFM`Private`Gp = Dot[CasimirRFM`Private`Vinv, 
            Dot[CasimirRFM`Private`G, 
             Transpose[CasimirRFM`Private`Vinv]]]; 
         CasimirRFM`Private`bgp = Dot[
            (Dot[#, 
             Inverse[
              Dot[
               Transpose[#], #]], 
             Transpose[#]]& )[CasimirRFM`Private`M], 
            Part[CasimirRFM`Private`el, 2]]; CasimirRFM`Private`vg = Dot[
            Transpose[CasimirRFM`Private`V], CasimirRFM`Private`bgp]; (
          If[# == {}, 
           Return[CasimirRFM`Private`sum = 0], 
           CasimirRFM`Private`\[Beta]vec = 
            ReplaceAll[CasimirRFM`Private`hvec - CasimirRFM`Private`\[Eta]vec, 
              Part[#, 1]]; 
           CasimirRFM`Private`dvec = 
            Dot[CasimirRFM`Private`Vinv, CasimirRFM`Private`\[Beta]vec]; 
           CasimirRFM`Private`sum = Sqrt[
               Det[CasimirRFM`Private`Gp]] ((
               Pi^((CasimirRFM`Private`k - CasimirRFM`Private`kp)/2) 
               Gamma[CasimirRFM`Private`sp])/Gamma[CasimirRFM`Private`s]) 
             CasimirRFM`Ewald[
              CasimirRFM`Private`vg, CasimirRFM`Private`dvec, 
               CasimirRFM`Private`sp, CasimirRFM`Private`\[Alpha], 
               CasimirRFM`Private`Gp, CasimirRFM`Private`precision]; 
           Return[CasimirRFM`Private`sum]]& )[
           If[
           IdentityMatrix[CasimirRFM`Private`k] == CasimirRFM`Private`Dg, {
             Table[
             CasimirRFM`Private`\[Eta][CasimirRFM`Private`i] -> 0, {
              CasimirRFM`Private`i, 
               Length[CasimirRFM`Private`\[Eta]vec]}]}, 
            FindInstance[{Dot[
                Transpose[
                IdentityMatrix[CasimirRFM`Private`k] - CasimirRFM`Private`Dg],
                 CasimirRFM`Private`\[Eta]vec - CasimirRFM`Private`hvec] == 0, 
              AllTrue[CasimirRFM`Private`\[Eta]vec, Element[#, Integers]& ]}, 
             CasimirRFM`Private`\[Eta]vec]]]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {}, "FullName" -> 
    "CasimirRFM`ReducedLatticeSum"|>, False]]], "Output",
