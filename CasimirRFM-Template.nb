         Pattern[CasimirRFM`Private`g, 
          Blank[]], 
         PatternTest[
          Pattern[CasimirRFM`Private`Dim, 
           Blank[]], IntegerQ]] :> (
        CasimirRFM`TraceFermions[
         CasimirRFM`Private`fermions, CasimirRFM`Private`g, 
          CasimirRFM`Private`Dim] = If[CasimirRFM`Private`fermions == {}, 0, 
          Sum[
           If[Abs[
              Part[CasimirRFM`Private`fermions, CasimirRFM`Private`i]] == 3/2, 
            CasimirRFM`TraceRS[CasimirRFM`Private`g, CasimirRFM`Private`Dim, 
