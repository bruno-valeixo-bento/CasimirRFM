    "SpinStructures[\!\(\*StyleBox[\"generatorList\",\nFontSlant->\"Italic\"]\
\)] returns the most general spin structure on the RFM with generators \
\!\(\*StyleBox[\"generatorList\",\nFontSlant->\"Italic\"]\) = \
{\!\(\*SubscriptBox[\(g\), \(1\)]\),\!\(\*SubscriptBox[\(g\), \(2\)]\),...} \
in terms of a vector \!\(\*OverscriptBox[\(h\), \(\[RightArrow]\)]\) = \
{\!\(\*SubscriptBox[\(h\), \(1\)]\),...,\!\(\*SubscriptBox[\(h\), \(k\)]\)} \
encoding the fermion boundary conditions compatible with the quotient \
\!\(\*SuperscriptBox[\(T\), \(k\)]\)/\[CapitalGamma], where \[CapitalGamma] \
is the finite group generated by {\!\(\*SubscriptBox[\(g\), \
\(1\)]\),\!\(\*SubscriptBox[\(g\), \(2\)]\),...}. The output is the \
Association <|\"GeneralForm\" \[Rule] {\!\(\*SubscriptBox[\(h\), \
\(1\)]\),...,\!\(\*SubscriptBox[\(h\), \(k\)]\)},\"Allowed\" \[Rule] List of \
allowed structures|>.", "Documentation" -> None, "OwnValues" -> None, 
    "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, CasimirRFM`SpinStructures, {CasimirRFM`SpinStructures[
         Pattern[CasimirRFM`Private`group, 
          Blank[List]]] :> 
       Block[{CasimirRFM`Private`n, CasimirRFM`Private`h = $CellContext`h, 
          CasimirRFM`Private`H, CasimirRFM`Private`spins, 
          CasimirRFM`Private`allowed, CasimirRFM`Private`hvec, 
          CasimirRFM`Private`rule}, If[
           Not[
            AllTrue[CasimirRFM`Private`group, MatchQ[#, {
               PatternTest[
                Blank[], MatrixQ], 
               PatternTest[
                Blank[], VectorQ], 
               PatternTest[
                Blank[], NumericQ]}]& ]], Message[
             MessageName[CasimirRFM`SpinStructures, "arg"]]; Return[$Failed]]; 
         CasimirRFM`Private`n = Length[
            Part[
             First[CasimirRFM`Private`group], 1]]; 
         CasimirRFM`Private`spins = Tuples[{0, 1/2}, CasimirRFM`Private`n]; 
         CasimirRFM`Private`hvec = 
          Array[CasimirRFM`Private`h, CasimirRFM`Private`n]; 
         CasimirRFM`Private`H = Map[Part[#, 1]& , CasimirRFM`Private`group]; 
         CasimirRFM`Private`allowed = Select[CasimirRFM`Private`spins, AllTrue[
             Flatten[
              Table[
               ReplaceAll[
                Dot[
                 Transpose[
                 IdentityMatrix[CasimirRFM`Private`n] - Part[
                  CasimirRFM`Private`H, CasimirRFM`Private`j]], 
                 CasimirRFM`Private`hvec], 
                Flatten[
                 Map[{Part[#, 1] -> Part[#, 2]}& , 
                  Transpose[{CasimirRFM`Private`hvec, #}]]]], {
               CasimirRFM`Private`j, 
                Length[CasimirRFM`Private`H]}]], IntegerQ]& ]; 
         CasimirRFM`Private`allowed = 
          Select[CasimirRFM`Private`allowed, AllTrue[
             Flatten[
              ReplaceAll[
               Map[
               CasimirRFM`ElementOrder[#] (Part[#, 3] - Dot[
                 CasimirRFM`Private`hvec, 
                  Part[#, 2]])& , CasimirRFM`Private`group], 
               Flatten[
                Map[{Part[#, 1] -> Part[#, 2]}& , 
                 Transpose[{CasimirRFM`Private`hvec, #}]]]]], EvenQ]& ]; 
         CasimirRFM`Private`rule = 
          CasimirRFM`Private`RuleFromList[CasimirRFM`Private`allowed]; 
         Return[<|
            ReplaceAll[
             ReplaceAll[
             "GeneralForm" -> CasimirRFM`Private`hvec, 
              CasimirRFM`Private`rule], {CasimirRFM`Private`h[
                Pattern[CasimirRFM`Private`a, 
                 Blank[]]] :> 
              Subscript[CasimirRFM`Private`h, CasimirRFM`Private`a]}], 
            "Allowed" -> CasimirRFM`Private`allowed|>]; Null]}], "SubValues" -> 
    None, "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {}, "FullName" -> 
