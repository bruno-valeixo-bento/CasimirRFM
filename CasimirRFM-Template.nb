                    RowBox[{
                    RowBox[{"ReducedLatticeSum", "[", 
                    RowBox[{
                    RowBox[{"CasimirRFM`Private`Dim_", "?", "IntegerQ"}], ",",
                     "CasimirRFM`Private`el_", ",", 
                    RowBox[{"CasimirRFM`Private`hvec_", "?", "VectorQ"}], ",", 
                    RowBox[{"CasimirRFM`Private`G_", "?", "MatrixQ"}], ",", 
                    RowBox[{"CasimirRFM`Private`\[Epsilon]_", ":", 
                    FractionBox["1", "10000"]}]}], "]"}], ":=", 
                    RowBox[{"Block", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"CasimirRFM`Private`s", "=", 
                    FractionBox["CasimirRFM`Private`Dim", "2"]}], ",", 
                    RowBox[{"CasimirRFM`Private`k", "=", 
                    RowBox[{"Length", "[", "CasimirRFM`Private`G", "]"}]}], 
                    ",", 
                    RowBox[{"CasimirRFM`Private`Dg", "=", 
                    RowBox[{"CasimirRFM`Private`el", "\[LeftDoubleBracket]", 
                    "1", "\[RightDoubleBracket]"}]}], ",", 
                    "CasimirRFM`Private`sp", ",", "CasimirRFM`Private`kp", 
                    ",", "CasimirRFM`Private`Gp", ",", "CasimirRFM`Private`V",
                     ",", "CasimirRFM`Private`M", ",", 
                    "CasimirRFM`Private`Vinv", ",", "CasimirRFM`Private`bgp", 
                    ",", "CasimirRFM`Private`vg", ",", 
                    RowBox[{"CasimirRFM`Private`\[Eta]vec", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    
                    RowBox[{"CasimirRFM`Private`\[Eta]", "[", 
                    "CasimirRFM`Private`i", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"CasimirRFM`Private`i", ",", 
                    RowBox[{"Length", "[", "CasimirRFM`Private`hvec", "]"}]}],
                     "}"}]}], "]"}]}], ",", "CasimirRFM`Private`\[Beta]vec", 
                    ",", "CasimirRFM`Private`dvec", ",", 
                    "CasimirRFM`Private`sum", ",", 
                    "CasimirRFM`Private`\[Alpha]", ",", 
                    RowBox[{"CasimirRFM`Private`precision", "=", 
                    
                    RowBox[{"N", "[", "CasimirRFM`Private`\[Epsilon]", 
                    "]"}]}]}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"AllTrue", "[", 
                    
                    RowBox[{"CasimirRFM`Private`G", ",", "NumericQ", ",", 
                    "2"}], "]"}]}], "||", 
                    RowBox[{"!", 
                    
                    RowBox[{"PositiveDefiniteMatrixQ", "[", 
                    "CasimirRFM`Private`G", "]"}]}]}], ",", 
                    RowBox[{
                    RowBox[{"Message", "[", 
                    StyleBox[
                    RowBox[{"ReducedLatticeSum", "::", "metric"}], 
                    "MessageName"], "]"}], ";", 
                    RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], 
