   StripOnInput->False],
  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "GetInvariantMetric[generatorList] returns the invariant metric G and \
geometric moduli {\!\(\*SubscriptBox[\(c\), \
\(1\)]\),\!\(\*SubscriptBox[\(c\), \(2\)]\),...} from a list of generators \!\
\(\*StyleBox[\"generatorList\",\nFontSlant->\"Italic\"]\) = \
{\!\(\*SubscriptBox[\(g\), \(1\)]\),\!\(\*SubscriptBox[\(g\), \(2\)]\),...} \
in the form {number of moduli, {\!\(\*SubscriptBox[\(c\), \
\(1\)]\),\!\(\*SubscriptBox[\(c\), \(2\)]\),...},G}.", "Documentation" -> 
    None, "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, CasimirRFM`GetInvariantMetric, {CasimirRFM`GetInvariantMetric[
         Pattern[CasimirRFM`Private`gen, 
          Blank[]]] :> 
       Module[{CasimirRFM`Private`d, CasimirRFM`Private`Dlist, 
          CasimirRFM`Private`\[Delta]P, CasimirRFM`Private`c = $CellContext`c,
           CasimirRFM`Private`var, CasimirRFM`Private`nvar, 
          CasimirRFM`Private`eqs, CasimirRFM`Private`system, 
          CasimirRFM`Private`nmoduli, CasimirRFM`Private`nullspace, 
          CasimirRFM`Private`moduli, CasimirRFM`Private`solvec, 
          CasimirRFM`Private`sol\[Delta]P, CasimirRFM`Private`coeff}, 
         CasimirRFM`Private`d = Length[
            First[
             First[CasimirRFM`Private`gen]]]; CasimirRFM`Private`Dlist = Table[
            Part[
             Part[CasimirRFM`Private`gen, CasimirRFM`Private`i], 1], {
            CasimirRFM`Private`i, 1, 
             Length[CasimirRFM`Private`gen]}]; 
         CasimirRFM`Private`\[Delta]P = Table[
            Which[CasimirRFM`Private`i >= CasimirRFM`Private`j, 
             Subscript[
             CasimirRFM`Private`\[Delta]p, CasimirRFM`Private`i, 
              CasimirRFM`Private`j], True, 
             Subscript[
             CasimirRFM`Private`\[Delta]p, CasimirRFM`Private`j, 
              CasimirRFM`Private`i]], {
            CasimirRFM`Private`i, 1, CasimirRFM`Private`d}, {
            CasimirRFM`Private`j, 1, CasimirRFM`Private`d}]; 
         CasimirRFM`Private`var = DeleteDuplicates[
            Flatten[CasimirRFM`Private`\[Delta]P]]; 
         CasimirRFM`Private`nvar = Length[CasimirRFM`Private`var]; 
         CasimirRFM`Private`eqs = Flatten[
            Table[Dot[
               Transpose[
                Part[CasimirRFM`Private`Dlist, CasimirRFM`Private`i]], 
               CasimirRFM`Private`\[Delta]P, 
               Part[CasimirRFM`Private`Dlist, CasimirRFM`Private`i]] - 
             CasimirRFM`Private`\[Delta]P, {CasimirRFM`Private`i, 1, 
              Length[CasimirRFM`Private`Dlist]}]]; 
         CasimirRFM`Private`coeff = 
          CoefficientArrays[CasimirRFM`Private`eqs, CasimirRFM`Private`var]; 
         If[Length[CasimirRFM`Private`coeff] > 1, 
           CasimirRFM`Private`system = Part[
              Normal[
               CoefficientArrays[
               CasimirRFM`Private`eqs, CasimirRFM`Private`var]], 2]; 
           CasimirRFM`Private`nmoduli = 
            CasimirRFM`Private`nvar - MatrixRank[CasimirRFM`Private`system]; 
           CasimirRFM`Private`nullspace = 
            NullSpace[CasimirRFM`Private`system]; 
           CasimirRFM`Private`moduli = Table[
              Subscript[CasimirRFM`Private`c, CasimirRFM`Private`k], {
              CasimirRFM`Private`k, 1, 
               Length[CasimirRFM`Private`nullspace]}]; 
           CasimirRFM`Private`solvec = Dot[
              Transpose[CasimirRFM`Private`nullspace], 
              CasimirRFM`Private`moduli]; 
           CasimirRFM`Private`sol\[Delta]P = (Flatten[#, 1]& )[
              ReplaceAll[-CasimirRFM`Private`\[Delta]P, {
                Flatten[
                 Map[Part[#, 1] -> Part[#, 2]& , 
                  
                  Transpose[{
                   CasimirRFM`Private`var, CasimirRFM`Private`solvec}]]]}]]; 
           Null, CasimirRFM`Private`nmoduli = CasimirRFM`Private`nvar; 
           CasimirRFM`Private`moduli = Table[
              Subscript[CasimirRFM`Private`c, CasimirRFM`Private`k], {
              CasimirRFM`Private`k, 1, CasimirRFM`Private`nvar}]; 
           CasimirRFM`Private`sol\[Delta]P = (Flatten[#, 1]& )[
              ReplaceAll[CasimirRFM`Private`\[Delta]P, {
                Flatten[
                 Map[Part[#, 1] -> Part[#, 2]& , 
                  
                  Transpose[{
                   CasimirRFM`Private`var, CasimirRFM`Private`moduli}]]]}]]; 
           Null]; Return[{
           CasimirRFM`Private`nmoduli, CasimirRFM`Private`moduli, 
            ReplaceAll[
            CasimirRFM`Private`sol\[Delta]P, {
             Subscript[CasimirRFM`Private`c, 
                Pattern[CasimirRFM`Private`i, 
                 Blank[]]] :> -
               Subscript[CasimirRFM`Private`c, CasimirRFM`Private`i]}]}]; 
         Null]}], "SubValues" -> None, "DefaultValues" -> None, "NValues" -> 
