           Blank[]], NumericQ], 
         PatternTest[
          Pattern[CasimirRFM`Private`G0, 
           Blank[]], MatrixQ], 
         Optional[
          Pattern[CasimirRFM`Private`\[Epsilon], 
           PatternTest[
            Blank[], NumericQ]], 
          Rational[1, 10000]]] :> 
       Block[{CasimirRFM`Private`k = Length[CasimirRFM`Private`c0], 
          CasimirRFM`Private`rmaxn, CasimirRFM`Private`rmaxk, 
          CasimirRFM`Private`Ginv, CasimirRFM`Private`detG, 
          CasimirRFM`Private`normG, CasimirRFM`Private`normGdual, 
          CasimirRFM`Private`deltaTerm, CasimirRFM`Private`offsetTerm, 
          CasimirRFM`Private`points, CasimirRFM`Private`pointsk, 
          CasimirRFM`Private`tot, CasimirRFM`Private`sumvec, 
          CasimirRFM`Private`vecN, CasimirRFM`Private`isum, 
          CasimirRFM`Private`vecs, CasimirRFM`Private`rminn, 
          CasimirRFM`Private`rmink, CasimirRFM`Private`c = 
          N[CasimirRFM`Private`c0], CasimirRFM`Private`s = 
          N[CasimirRFM`Private`s0], CasimirRFM`Private`h = 
          N[CasimirRFM`Private`h0], CasimirRFM`Private`G = 
          N[CasimirRFM`Private`G0, 10], CasimirRFM`Private`alpha = 
          N[CasimirRFM`Private`alpha0], CasimirRFM`Private`pi = N[Pi], 
          CasimirRFM`Private`Ne}, 
         CasimirRFM`Private`Ginv = Inverse[CasimirRFM`Private`G]; 
         CasimirRFM`Private`detG = 
          Det[CasimirRFM`Private`G]; {
           CasimirRFM`Private`rmaxn, CasimirRFM`Private`rmaxk} = 
          CasimirRFM`Private`GetEwaldCutoffs[
           CasimirRFM`Private`k, CasimirRFM`Private`s, 
            CasimirRFM`Private`alpha, CasimirRFM`Private`detG, 
            CasimirRFM`Private`\[Epsilon]/2]; CasimirRFM`Private`points = N[
            CasimirRFM`Private`GetEwaldLatticeByNorm[
            CasimirRFM`Private`rmaxn, CasimirRFM`Private`G, 
             CasimirRFM`Private`c]]; CasimirRFM`Private`pointsk = N[
            CasimirRFM`Private`GetEwaldLatticeByNorm[
            CasimirRFM`Private`rmaxk, CasimirRFM`Private`Ginv, -
             CasimirRFM`Private`h]]; 
         If[CasimirRFM`Private`k == 1, 
           CasimirRFM`Private`points = Map[{#}& , CasimirRFM`Private`points]; 
           CasimirRFM`Private`pointsk = 
            Map[{#}& , CasimirRFM`Private`pointsk]; Null]; 
         CasimirRFM`Private`sumvec = {0, 0}; 
         AddTo[CasimirRFM`Private`sumvec, 
           CasimirRFM`Private`EwaldKernel[
           CasimirRFM`Private`c, CasimirRFM`Private`h, CasimirRFM`Private`s, 
            CasimirRFM`Private`alpha, CasimirRFM`Private`G, 
            CasimirRFM`Private`Ginv, CasimirRFM`Private`points, 
            CasimirRFM`Private`pointsk]]; TimesBy[
           Part[CasimirRFM`Private`sumvec, 2], 
           CasimirRFM`Private`pi^(2 CasimirRFM`Private`s - 
             CasimirRFM`Private`k/2)/(Gamma[CasimirRFM`Private`s] 
           Sqrt[CasimirRFM`Private`detG])]; 
         CasimirRFM`Private`deltaTerm = 
          If[CasimirRFM`Private`h == 
            ConstantArray[0, CasimirRFM`Private`k], (
             CasimirRFM`Private`pi^(CasimirRFM`Private`k/2) 
             CasimirRFM`Private`alpha^(CasimirRFM`Private`s - 
               CasimirRFM`Private`k/2))/(Sqrt[CasimirRFM`Private`detG] 
            Gamma[CasimirRFM`Private`s] (CasimirRFM`Private`s - 
             CasimirRFM`Private`k/2)), 0]; 
         CasimirRFM`Private`offsetTerm = If[
            Apply[And, 
             Map[
             IntegerQ, CasimirRFM`Private`c0]], -((
              CasimirRFM`Private`alpha^CasimirRFM`Private`s 
              Exp[(-2) CasimirRFM`Private`pi I 
                Dot[CasimirRFM`Private`h, CasimirRFM`Private`c]])/Gamma[
             1 + CasimirRFM`Private`s]), 0]; Return[
           Chop[
           Total[CasimirRFM`Private`sumvec] + CasimirRFM`Private`deltaTerm + 
            CasimirRFM`Private`offsetTerm]]; Null]}], "SubValues" -> None, 
