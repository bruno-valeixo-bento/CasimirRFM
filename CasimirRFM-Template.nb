                    RowBox[{"0", ",", "CasimirRFM`Private`k"}], "]"}]}], 
                    "]"}], "&"}]}], "]"}]}], "]"}]}], ";", 
                    RowBox[{"CasimirRFM`Private`sum", "+=", 
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"TraceBosons", "[", 
                    RowBox[{
                    
                    RowBox[{"#1", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], ",", "CasimirRFM`Private`el", 
                    ",", "CasimirRFM`Private`Dim"}], "]"}], " ", 
                    RowBox[{"ReducedLatticeSum", "[", 
                    
                    RowBox[{"CasimirRFM`Private`Dim", ",", 
                    "CasimirRFM`Private`el", ",", 
                    
                    RowBox[{"#1", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], ",", 
                    "CasimirRFM`Private`Geval", ",", 
                    "CasimirRFM`Private`\[Epsilon]"}], "]"}]}], "&"}], ")"}], 
                    "/@", "CasimirRFM`Private`subspec"}], "]"}]}]}]}], "]"}], 
                    ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Lookup", "[", 
                    
                    RowBox[{"CasimirRFM`Private`spectrum", ",", 
                    "\"Fermions\"", ",", 
                    RowBox[{"{", "}"}]}], "]"}], "\[NotEqual]", 
                    RowBox[{"{", "}"}]}], ",", 
                    RowBox[{
                    RowBox[{"CasimirRFM`Private`subspec", "=", 
                    RowBox[{"KeyValueMap", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"#2", ",", "#1"}], "}"}], "&"}], ",", 
                    RowBox[{"GroupBy", "[", 
                    RowBox[{
                    
                    RowBox[{"CasimirRFM`Private`spectrum", "[", 
                    "\"Fermions\"", "]"}], ",", 
                    RowBox[{
                    RowBox[{"Lookup", "[", 
                    
                    RowBox[{"#1", ",", "\"TwistedBoundaryConditions\"", ",", 
                    "CasimirRFM`Private`hvec"}], "]"}], "&"}]}], "]"}]}], 
                    "]"}]}], ";", 
                    RowBox[{"CasimirRFM`Private`sum", "+=", 
                    RowBox[{"-", 
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"TraceFermions", "[", 
                    RowBox[{
                    
                    RowBox[{"#1", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], ",", "CasimirRFM`Private`el", 
                    ",", "CasimirRFM`Private`Dim"}], "]"}], " ", 
                    RowBox[{"ReducedLatticeSum", "[", 
                    
                    RowBox[{"CasimirRFM`Private`Dim", ",", 
                    "CasimirRFM`Private`el", ",", 
                    
                    RowBox[{"#1", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], ",", 
                    "CasimirRFM`Private`Geval", ",", 
                    "CasimirRFM`Private`\[Epsilon]"}], "]"}]}], "&"}], ")"}], 
                    "/@", "CasimirRFM`Private`subspec"}], "]"}]}]}]}]}], 
                    "]"}], ";"}], ",", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"CasimirRFM`Private`spectrum", 
                    "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                    "\[NotEqual]", 
                    RowBox[{"{", "}"}]}], ",", 
