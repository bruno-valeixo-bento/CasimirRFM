   "ObjectType" -> "Symbol", "Usage" -> 
    "FiniteOrderMatrices[k] returns representatives up to conjugacy by GL(k,\
\[DoubleStruckCapitalQ]) of all finite order k*k matrices, built out of \
direct sums of companion matrices of cyclotomic polynomials; the output is a \
list of pairs {order,matrix}.", "Documentation" -> None, "OwnValues" -> None, 
    "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, CasimirRFM`FiniteOrderMatrices, {
      CasimirRFM`FiniteOrderMatrices[
         PatternTest[
          Pattern[CasimirRFM`Private`k, 
           Blank[]], IntegerQ]] :> 
       Module[{CasimirRFM`Private`list, CasimirRFM`Private`size, 
          CasimirRFM`Private`plist, CasimirRFM`Private`polvec, 
          CasimirRFM`Private`solvec, CasimirRFM`Private`Mlist, 
          CasimirRFM`Private`orderlist}, CasimirRFM`Private`list = {}; 
         For[CasimirRFM`Private`n = 1, CasimirRFM`Private`n <= 
           2 CasimirRFM`Private`k^2, 
           Increment[CasimirRFM`Private`n], 
           If[EulerPhi[CasimirRFM`Private`n] <= CasimirRFM`Private`k, 
             AppendTo[CasimirRFM`Private`list, {CasimirRFM`Private`n, 
               EulerPhi[CasimirRFM`Private`n]}]]; Null]; 
         CasimirRFM`Private`size = Sum[CasimirRFM`Private`c[
              Part[CasimirRFM`Private`list, CasimirRFM`Private`i, 1]] 
            Part[CasimirRFM`Private`list, CasimirRFM`Private`i, 2], {
            CasimirRFM`Private`i, 1, 
             Length[CasimirRFM`Private`list]}]; 
         CasimirRFM`Private`solvec = Solve[
            Flatten[{CasimirRFM`Private`size == CasimirRFM`Private`k, 
              Table[CasimirRFM`Private`c[
                 Part[CasimirRFM`Private`list, CasimirRFM`Private`i, 1]] >= 
               0, {CasimirRFM`Private`i, 1, 
                Length[CasimirRFM`Private`list]}]}], 
            Table[
             CasimirRFM`Private`c[
              Part[CasimirRFM`Private`list, CasimirRFM`Private`i, 1]], {
             CasimirRFM`Private`i, 
              Length[CasimirRFM`Private`list]}], Integers]; 
         CasimirRFM`Private`plist = Map[DeleteCases[#, {
              Pattern[CasimirRFM`Private`a, 
               Blank[]], 0}]& , 
            Map[ReplaceAll[
              Table[{
                CasimirRFM`Private`\[CapitalPhi][
                 Part[CasimirRFM`Private`list, CasimirRFM`Private`i, 1]], 
                CasimirRFM`Private`c[
                 Part[CasimirRFM`Private`list, CasimirRFM`Private`i, 1]]}, {
               CasimirRFM`Private`i, 1, 
                Length[CasimirRFM`Private`list]}], #]& , 
             CasimirRFM`Private`solvec]]; 
         CasimirRFM`Private`polvec = Map[ReplaceAll[
             Flatten[
              Map[Table[
                Part[#, 1], {CasimirRFM`Private`i, 1, 
                 Part[#, 2]}]& , #]], CasimirRFM`Private`\[CapitalPhi][
               Pattern[CasimirRFM`Private`n, 
                Blank[]]] :> 
             Cyclotomic[CasimirRFM`Private`n, CasimirRFM`Private`x]]& , 
            CasimirRFM`Private`plist]; 
         CasimirRFM`Private`orderlist = Map[LCM[
             Evaluate[
              Apply[Sequence, #]]]& , 
            Map[Flatten[
              Map[Table[
                ReplaceAll[
                 Part[#, 1], {CasimirRFM`Private`\[CapitalPhi][
                    Pattern[CasimirRFM`Private`n, 
                    Blank[]]] :> CasimirRFM`Private`n}], {
                CasimirRFM`Private`i, 1, 
                 Part[#, 2]}]& , #]]& , CasimirRFM`Private`plist]]; 
         CasimirRFM`Private`Mlist = Map[BlockDiagonalMatrix[
             Map[
             CasimirRFM`GetCompanionMatrix[#, CasimirRFM`Private`x]& , #]]& , 
            CasimirRFM`Private`polvec]; Return[
           SortBy[
            
            Transpose[{
             CasimirRFM`Private`orderlist, CasimirRFM`Private`Mlist}], 1/
            Part[#, 1]& ]]; Null]}], "SubValues" -> None, "DefaultValues" -> 
