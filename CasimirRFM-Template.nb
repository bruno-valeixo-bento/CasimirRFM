                    RowBox[{"CasimirRFM`Private`group", 
                    "\[LeftDoubleBracket]", "CasimirRFM`Private`i", 
                    "\[RightDoubleBracket]"}], ",", 
                    "CasimirRFM`Private`Dim"}], "]"}], " ", 
                    RowBox[{"Ewald", "[", 
