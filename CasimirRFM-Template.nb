                    RowBox[{"{", "#1", "}"}], "&"}], ")"}], "/@", 
                    "CasimirRFM`Private`points"}]}], ";", 
                    RowBox[{"CasimirRFM`Private`pointsk", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"{", "#1", "}"}], "&"}], ")"}], "/@", 
                    "CasimirRFM`Private`pointsk"}]}], ";"}]}], "]"}], ";", 
                    RowBox[{"CasimirRFM`Private`sumvec", "=", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", "0"}], "}"}]}], ";", 
                    RowBox[{"CasimirRFM`Private`sumvec", "+=", 
