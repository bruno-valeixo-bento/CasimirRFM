                    RowBox[{"CasimirRFM`Private`GetEwaldLatticeByNorm", "[", 
                    
                    RowBox[{"CasimirRFM`Private`rmaxk", ",", 
                    "CasimirRFM`Private`Ginv", ",", 
                    RowBox[{"-", "CasimirRFM`Private`h"}]}], "]"}], "]"}]}], 
                    ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"CasimirRFM`Private`k", "\[Equal]", "1"}], ",", 
                    RowBox[{
