  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "GetInvariantForms[generatorList] returns a basis of p-forms invariant \
under the action of the group with generators \
\!\(\*StyleBox[\"generatorList\",\nFontSlant->\"Italic\"]\) = \
{\!\(\*SubscriptBox[\(g\), \(1\)]\),\!\(\*SubscriptBox[\(g\), \(2\)]\),...}, \
in the form {Betti numbers, List of invariant p-forms, List of p-form \
coefficients}. The form coefficients are given as a list of rules that can be \
used to define a SparseArray[coefficients\[LeftDoubleBracket]p+1\
\[RightDoubleBracket], ConstantArray[k,p]] encoding the components of a \
p-form on a k-dimensional space.", "Documentation" -> None, "OwnValues" -> 
    None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, CasimirRFM`GetInvariantForms, {CasimirRFM`GetInvariantForms[
         PatternTest[
          Pattern[CasimirRFM`Private`gList, 
           Blank[]], ListQ]] :> Module[{CasimirRFM`Private`k = Length[
            Part[
             First[CasimirRFM`Private`gList], 1]], CasimirRFM`Private`dBasis, 
          CasimirRFM`Private`genform, CasimirRFM`Private`tgenform, 
          CasimirRFM`Private`coeff, CasimirRFM`Private`sys = {}, 
          CasimirRFM`Private`sol, CasimirRFM`Private`invform, 
          CasimirRFM`Private`Betti, CasimirRFM`Private`forms}, 
         CasimirRFM`Private`invform = {1}; 
         CasimirRFM`Private`dBasis = 
          CasimirRFM`Private`diffBasis[CasimirRFM`Private`k]; 
         CasimirRFM`Private`Betti = Join[{1}, 
            ConstantArray[0, CasimirRFM`Private`k]]; 
         For[CasimirRFM`Private`i = 1, CasimirRFM`Private`i <= 
           CasimirRFM`Private`k, 
           Increment[CasimirRFM`Private`i], CasimirRFM`Private`coeff = Table[
              CasimirRFM`Private`c[CasimirRFM`Private`j], {
              CasimirRFM`Private`j, 1, 
               Length[
                Part[CasimirRFM`Private`dBasis, CasimirRFM`Private`i]]}]; 
           CasimirRFM`Private`genform = Dot[CasimirRFM`Private`coeff, 
              Part[CasimirRFM`Private`dBasis, CasimirRFM`Private`i]]; 
           CasimirRFM`Private`sys = {}; 
           For[CasimirRFM`Private`j = 1, CasimirRFM`Private`j <= 
             Length[CasimirRFM`Private`gList], 
             Increment[CasimirRFM`Private`j], 
             CasimirRFM`Private`tgenform = TensorExpand[
                ReplaceAll[CasimirRFM`Private`genform, 
                 CasimirRFM`Private`rep[
                  Part[CasimirRFM`Private`gList, CasimirRFM`Private`j]]]]; (
              AppendTo[CasimirRFM`Private`sys, 
               If[Length[#] > 1, 
                Part[#, 2], 0]]& )[
               Normal[
                CoefficientArrays[
                CasimirRFM`Private`genform - CasimirRFM`Private`tgenform, 
                 Part[CasimirRFM`Private`dBasis, CasimirRFM`Private`i]]]]; 
             Null]; CasimirRFM`Private`sys = 
            Flatten[CasimirRFM`Private`sys, 1]; 
           CasimirRFM`Private`sol = Part[
              Solve[CasimirRFM`Private`sys == 0], 1]; 
           AppendTo[CasimirRFM`Private`invform, 
             Simplify[
              ReplaceAll[
               ReplaceAll[
               CasimirRFM`Private`genform, CasimirRFM`Private`sol], {
               0 TensorWedge[
                   BlankNullSequence[]] :> 0}]]]; 
           Part[CasimirRFM`Private`Betti, CasimirRFM`Private`i + 1] = (
             Length[CasimirRFM`Private`coeff] - If[Length[#] > 1, 
              MatrixRank[
               Normal[
                Part[#, 2]]], 0]& )[
              CoefficientArrays[CasimirRFM`Private`sys]]; Null]; 
         CasimirRFM`Private`forms = Map[(DeleteCases[#, 0]& )[
             Flatten[
              CoefficientList[#, 
               Table[
                CasimirRFM`Private`c[CasimirRFM`Private`a], {
                CasimirRFM`Private`a, 
                 Binomial[CasimirRFM`Private`k, 
                  Floor[CasimirRFM`Private`k/2]]}]]]]& , 
            CasimirRFM`Private`invform]; 
         Return[{CasimirRFM`Private`Betti, CasimirRFM`Private`forms, 
            CasimirRFM`Private`GetFormCoefficients[
            CasimirRFM`Private`forms]}]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {}, "FullName" -> 
    "CasimirRFM`GetInvariantForms"|>, False]]], "Output",
 CellChangeTimes->{{3.993033172797875*^9, 3.993033222337174*^9}, {
