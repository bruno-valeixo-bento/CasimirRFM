                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"#1", "\[Equal]", 
                    RowBox[{"{", "}"}]}], ",", 
                    RowBox[{"Return", "[", 
                    RowBox[{"CasimirRFM`Private`sum", "=", "0"}], "]"}], ",", 
                    
                    RowBox[{
                    RowBox[{"CasimirRFM`Private`\[Beta]vec", "=", 
                    RowBox[{
                    
                    RowBox[{"CasimirRFM`Private`hvec", "-", 
                    "CasimirRFM`Private`\[Eta]vec"}], "/.", 
                    "\[VeryThinSpace]", 
                    
                    RowBox[{"#1", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}]}]}], ";", 
                    RowBox[{"CasimirRFM`Private`dvec", "=", 
                    
                    RowBox[{"CasimirRFM`Private`Vinv", ".", 
                    "CasimirRFM`Private`\[Beta]vec"}]}], ";", 
                    RowBox[{"CasimirRFM`Private`sum", "=", 
                    FractionBox[
                    RowBox[{
                    SqrtBox[
                    RowBox[{"Det", "[", "CasimirRFM`Private`Gp", "]"}]], " ", 
                    
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox["\[Pi]", 
                    FractionBox[
                    
                    RowBox[{"CasimirRFM`Private`k", "-", 
                    "CasimirRFM`Private`kp"}], "2"]], " ", 
                    RowBox[{"Gamma", "[", "CasimirRFM`Private`sp", "]"}]}], 
                    ")"}], " ", 
                    RowBox[{"Ewald", "[", 
                    
                    RowBox[{"CasimirRFM`Private`vg", ",", 
