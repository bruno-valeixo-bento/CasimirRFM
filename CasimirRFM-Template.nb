\!\(\*OverscriptBox[\(z\), \(\[RightArrow]\)]\)\[RightArrow] Q \
\!\(\*OverscriptBox[\(z\), \(\[RightArrow]\)]\)+\!\(\*OverscriptBox[\(q\), \(\
\[RightArrow]\)]\) is in the normalizer of group \[CapitalGamma]. If not, it \
also checks whether Q is in the normalizer of the point group.", 
    "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[
     DownValues, CasimirRFM`NormalizerQ, {CasimirRFM`NormalizerQ[
         Pattern[CasimirRFM`Private`group, 
          Blank[List]], {
          PatternTest[
           Pattern[CasimirRFM`Private`Q, 
            Blank[]], MatrixQ], 
          PatternTest[
           Pattern[CasimirRFM`Private`q, 
            Blank[]], VectorQ]}] :> 
       Module[{CasimirRFM`Private`newgroup, CasimirRFM`Private`oldgroup = 
          Map[Part[#, 
             Span[1, -2]]& , CasimirRFM`Private`group], 
          CasimirRFM`Private`check}, If[
           Not[
            And[
             AllTrue[CasimirRFM`Private`group, MatchQ[#, {
                PatternTest[
                 Blank[], MatrixQ], 
                PatternTest[
                 Blank[], VectorQ], 
                PatternTest[
                 Blank[], NumericQ]}]& ], 
             MatchQ[{CasimirRFM`Private`Q, CasimirRFM`Private`q}, {
               PatternTest[
                Blank[], MatrixQ], 
               PatternTest[
                Blank[], VectorQ]}]]], Message[
             MessageName[CasimirRFM`NormalizerQ, "arg"]]; Return[$Failed]]; 
         CasimirRFM`Private`newgroup = Map[{
             Dot[CasimirRFM`Private`Q, 
              Part[#, 1], 
              Inverse[CasimirRFM`Private`Q]], 
             (Mod[#, 1]& )[Dot[CasimirRFM`Private`Q, 
                Part[#, 2]] + CasimirRFM`Private`q - Dot[
               Dot[CasimirRFM`Private`Q, 
                Part[#, 1], 
                Inverse[CasimirRFM`Private`Q]], CasimirRFM`Private`q]]}& , 
            CasimirRFM`Private`oldgroup]; 
         CasimirRFM`Private`check = 
          Sort[CasimirRFM`Private`newgroup] == 
           Sort[CasimirRFM`Private`oldgroup]; 
         If[CasimirRFM`Private`check == True, 
           Return[CasimirRFM`Private`check], 
           If[Sort[
              Map[Part[#, 1]& , CasimirRFM`Private`newgroup]] == Sort[
              Map[Part[#, 1]& , CasimirRFM`Private`oldgroup]], 
            Return["True for point group only."], False]]; Null]}], 
