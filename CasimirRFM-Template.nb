                    "CasimirRFM`Private`vecN", ",", "CasimirRFM`Private`isum",
                     ",", "CasimirRFM`Private`vecs", ",", 
                    "CasimirRFM`Private`rminn", ",", 
                    "CasimirRFM`Private`rmink", ",", 
                    RowBox[{"CasimirRFM`Private`c", "=", 
                    RowBox[{"N", "[", "CasimirRFM`Private`c0", "]"}]}], ",", 
                    RowBox[{"CasimirRFM`Private`s", "=", 
                    RowBox[{"N", "[", "CasimirRFM`Private`s0", "]"}]}], ",", 
                    RowBox[{"CasimirRFM`Private`h", "=", 
                    RowBox[{"N", "[", "CasimirRFM`Private`h0", "]"}]}], ",", 
                    RowBox[{"CasimirRFM`Private`G", "=", 
                    RowBox[{"N", "[", 
                    RowBox[{"CasimirRFM`Private`G0", ",", "10"}], "]"}]}], 
                    ",", 
                    RowBox[{"CasimirRFM`Private`alpha", "=", 
                    RowBox[{"N", "[", "CasimirRFM`Private`alpha0", "]"}]}], 
                    ",", 
                    RowBox[{"CasimirRFM`Private`pi", "=", 
                    RowBox[{"N", "[", "\[Pi]", "]"}]}], ",", 
                    "CasimirRFM`Private`Ne"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"CasimirRFM`Private`Ginv", "=", 
                    
                    TemplateBox[{"CasimirRFM`Private`G"}, "Inverse", 
                    SyntaxForm -> SuperscriptBox]}], ";", 
                    RowBox[{"CasimirRFM`Private`detG", "=", 
                    RowBox[{"Det", "[", "CasimirRFM`Private`G", "]"}]}], ";", 
                    
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"CasimirRFM`Private`rmaxn", ",", 
                    "CasimirRFM`Private`rmaxk"}], "}"}], "=", 
