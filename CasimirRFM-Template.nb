                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"CasimirRFM`Private`cvec", ",", 
                    RowBox[{"CasimirRFM`Private`k", "=", 
                    RowBox[{"Length", "[", "CasimirRFM`Private`G", "]"}]}], 
                    ",", "CasimirRFM`Private`Geval", ",", 
                    RowBox[{"CasimirRFM`Private`sum", "=", "0"}], ",", 
                    "CasimirRFM`Private`subspec"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"CasimirRFM`Private`cvec", "[", 
                    "CasimirRFM`Private`g_", "]"}], ":=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    
                    RowBox[{"IdentityMatrix", "[", "CasimirRFM`Private`k", 
                    "]"}], "-", 
                    
                    RowBox[{"CasimirRFM`Private`g", "\[LeftDoubleBracket]", 
                    "1", "\[RightDoubleBracket]"}]}], ")"}], ".", 
                    "CasimirRFM`Private`zvec"}], "-", 
                    
                    RowBox[{"CasimirRFM`Private`g", "\[LeftDoubleBracket]", 
                    "2", "\[RightDoubleBracket]"}]}]}], ";", 
                    RowBox[{"CasimirRFM`Private`Geval", "=", 
                    RowBox[{
                    FractionBox["CasimirRFM`Private`G", 
                    SuperscriptBox[
                    RowBox[{"Det", "[", "CasimirRFM`Private`G", "]"}], 
                    RowBox[{"1", "/", "CasimirRFM`Private`k"}]]], "/.", 
